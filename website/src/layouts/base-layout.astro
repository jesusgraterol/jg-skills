---
import { GitBranch } from '@lucide/astro';
import BrandLogo from 'jg-personal-astro-ui/brand-logo';
import Button from 'jg-personal-astro-ui/button';
import DocumentHead from 'jg-personal-astro-ui/document-head';
import JgMark from 'jg-personal-astro-ui/jg-mark';
import SiteFooter from 'jg-personal-astro-ui/site-footer';
import SiteHeader from 'jg-personal-astro-ui/site-header';
import SkipLink from 'jg-personal-astro-ui/skip-link';
import TextLink from 'jg-personal-astro-ui/text-link';
import ThemeControl from 'jg-personal-astro-ui/theme-control';
import ThemeInitScript from 'jg-personal-astro-ui/theme-init-script';

import { SITE_CONFIG } from '../site.config.ts';
import {
  buildStructuredData,
  type IBreadcrumbItem,
  type IListedPage,
  type IStructuredDataSkill,
  type IStructuredDataType,
} from '../utilities/seo/index.ts';
import '../styles/global.css';

interface IBaseLayoutProps {
  breadcrumbs?: readonly IBreadcrumbItem[] | undefined;
  description: string;
  // pages a website page lists, published as its structured item list
  listedPages?: readonly IListedPage[] | undefined;
  // the skill a skill page documents, published as structured source code
  skill?: IStructuredDataSkill | undefined;
  structuredDataTitle?: string | undefined;
  structuredDataType?: IStructuredDataType | undefined;
  title: string;
}

// an indexable page names its canonical URL; a noindex page has none, which would contradict noindex
type Props = IBaseLayoutProps &
  (
    | { canonicalPath: string; noIndex?: false | undefined }
    | { canonicalPath?: undefined; noIndex: true }
  );

const {
  breadcrumbs,
  canonicalPath,
  description,
  listedPages,
  noIndex = false,
  skill,
  structuredDataType,
  title,
  structuredDataTitle = title,
} = Astro.props;
const toSiteUrl = (path: string): string => new URL(path, SITE_CONFIG.url).toString();
const canonicalUrl = canonicalPath === undefined ? undefined : toSiteUrl(canonicalPath);
const structuredData =
  structuredDataType && canonicalUrl
    ? buildStructuredData({
        breadcrumbs,
        canonicalUrl,
        description,
        listedPages,
        skill,
        title: structuredDataTitle,
        type: structuredDataType,
      })
    : undefined;
const { openGraph } = SITE_CONFIG;
const footerColumns = [
  { title: 'Explore', links: SITE_CONFIG.navigation },
  {
    title: 'Project',
    links: [
      { external: true, href: SITE_CONFIG.repositoryUrl, label: 'Source repository' },
      { external: true, href: SITE_CONFIG.packagesUrl, label: 'jg-packages' },
      { href: '/llms.txt', label: 'llms.txt' },
      { href: '/#credits', label: 'Credits' },
    ],
  },
];
---

<!doctype html>
<html lang={SITE_CONFIG.language}>
  <head>
    <DocumentHead
      author={SITE_CONFIG.author.name}
      canonicalUrl={canonicalUrl}
      description={description}
      icons={[
        { href: '/favicon.ico', rel: 'icon', sizes: '16x16 32x32 48x48' },
        { href: '/favicons/32x32.png', rel: 'icon', sizes: '32x32', type: 'image/png' },
        { href: '/favicons/192x192.png', rel: 'apple-touch-icon' },
      ]}
      llmsTextUrl={toSiteUrl('/llms.txt')}
      locale={openGraph.locale}
      noIndex={noIndex}
      openGraphImage={{
        alt: openGraph.imageAlt,
        height: openGraph.height,
        type: openGraph.imageType,
        url: toSiteUrl(openGraph.image),
        width: openGraph.width,
      }}
      siteName={SITE_CONFIG.name}
      structuredData={structuredData}
      themeColors={SITE_CONFIG.themeColors}
      title={title}
      twitterCreator={SITE_CONFIG.author.twitterHandle}
    />
    <ThemeInitScript
      storageKey={SITE_CONFIG.storageKeys.theme}
      themeColors={SITE_CONFIG.themeColors}
    />
  </head>
  <body>
    <SkipLink />
    <SiteHeader
      currentPath={Astro.url.pathname}
      homeLabel={`${SITE_CONFIG.name} home`}
      items={SITE_CONFIG.navigation}
    >
      <BrandLogo
        slot="brand"
        name={SITE_CONFIG.name}
      >
        <JgMark
          slot="mark"
          class="size-8 shrink-0"
        />
      </BrandLogo>
      <Fragment slot="actions">
        <Button
          href={SITE_CONFIG.repositoryUrl}
          external
          externalIcon={false}
          size="icon"
          variant="ghost"
          title="Source repository"
        >
          <GitBranch
            class="size-4"
            aria-hidden="true"
          />
          <span class="sr-only">Source repository</span>
        </Button>
        <ThemeControl storageKey={SITE_CONFIG.storageKeys.theme} />
      </Fragment>
      <Fragment slot="mobile-actions">
        <Button
          href={SITE_CONFIG.repositoryUrl}
          external
          externalIcon={false}
          size="sm"
          variant="outline"
        >
          <GitBranch
            class="size-4"
            aria-hidden="true"
          />
          Source
        </Button>
        <ThemeControl
          class="ml-auto"
          storageKey={SITE_CONFIG.storageKeys.theme}
        />
      </Fragment>
    </SiteHeader>
    {/* Package pins and code examples must remain literal through Cloudflare email protection. */}
    <Fragment set:html="<!--email_off-->" />
    <main id="main-content">
      <slot />
    </main>
    <Fragment set:html="<!--/email_off-->" />
    <SiteFooter
      columns={footerColumns}
      notes={[SITE_CONFIG.url.replace('https://', ''), `${SITE_CONFIG.license} License, © 2026`]}
    >
      <BrandLogo
        slot="brand"
        name={SITE_CONFIG.name}
      >
        <JgMark
          slot="mark"
          class="size-8 shrink-0"
        />
      </BrandLogo>
      <Fragment slot="about">
        Built and maintained by <TextLink
          href={SITE_CONFIG.author.url}
          external
          >{SITE_CONFIG.author.name}</TextLink
        >. The skills put the <TextLink
          href={SITE_CONFIG.agenticCodingUrl}
          external
          >Agentic Coding</TextLink
        > approach into practice.
      </Fragment>
    </SiteFooter>
  </body>
</html>
