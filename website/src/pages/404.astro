---
import { ArrowLeft } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';

import BaseLayout from '../layouts/base-layout.astro';
import { SITE_CONFIG } from '../site.config.ts';
---

<BaseLayout
  description={`The requested ${SITE_CONFIG.name} page could not be found. Browse the skills from the home page instead.`}
  title={`Page not found | ${SITE_CONFIG.name}`}
  noIndex
>
  <section class="jg-section-space">
    <div class="jg-container-prose">
      <p class="eyebrow">404, page not found</p>
      <h1 class="display-title mt-6">No skill lives at this path.</h1>
      <p class="lede mt-8">
        The page may have moved, or the link may be incomplete. Every skill is listed on the home
        page.
      </p>
      <Button
        class="mt-9"
        href="/#skills"
      >
        <ArrowLeft
          class="size-4"
          aria-hidden="true"
        />
        Browse the skills
      </Button>
    </div>
  </section>
</BaseLayout>
