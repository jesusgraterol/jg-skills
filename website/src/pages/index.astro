---
import { ArrowDown } from '@lucide/astro';
import Button from 'jg-personal-astro-ui/button';
import InstallCommand from 'jg-personal-astro-ui/install-command';

import Credits from '../components/credits/credits.astro';
import PackagesBridge from '../components/packages-bridge/packages-bridge.astro';
import SessionDemo from '../components/session-demo/session-demo.astro';
import SkillCard from '../components/skill-card/skill-card.astro';
import StandardsSection from '../components/standards-section/standards-section.astro';
import WorkflowRun from '../components/workflow-run/workflow-run.astro';
import WorkedExample from '../components/worked-example/worked-example.astro';
import BaseLayout from '../layouts/base-layout.astro';
import { SITE_CONFIG } from '../site.config.ts';
import {
  loadSkills,
  SKILL_STAGES,
  PLANNING_RUNTIME_VERSION,
  type ISkillStage,
} from '../utilities/skill-catalog/index.ts';

const skills = await loadSkills();
const stages = (Object.keys(SKILL_STAGES) as ISkillStage[]).map((stage) => ({
  ...SKILL_STAGES[stage],
  skills: skills.filter((skill) => skill.stage === stage),
  stage,
}));
---

<BaseLayout
  canonicalPath="/"
  description={SITE_CONFIG.defaultDescription}
  listedPages={skills.map(({ name }) => ({ name, path: `/skills/${name}/` }))}
  title={`${SITE_CONFIG.name} | Agent skills for Claude Code and Codex`}
  structuredDataType="website"
>
  <section class="border-b border-border pt-14 pb-16 sm:pt-20 sm:pb-20">
    <div
      class="jg-container grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14"
    >
      <div>
        <p class="eyebrow">Explicit workflows + stack standards</p>
        <h1 class="display-title mt-6 text-4xl sm:text-5xl xl:text-6xl">
          A clear way to work
          <span class="block text-accent">with coding agents.</span>
        </h1>
        <p class="lede mt-7">
          Turn an agreed change into a plan, checked code and an explicit publication step. Choose
          when each workflow runs. Relevant stack standards guide Claude Code and Codex as they
          work.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <Button href="#workflow"
            >See the workflow <ArrowDown
              class="size-4"
              aria-hidden="true"
            /></Button
          ><Button
            href="#install"
            variant="outline"
            >Set up locally</Button
          >
        </div>
        <div class="mt-7">
          <InstallCommand
            command={SITE_CONFIG.commands.install}
            context="install command"
            id="hero-install-command"
            title="Install in your project"
          />
        </div>
        <Button
          class="mt-6"
          href="#skills"
          variant="link"
        >
          Browse the skills
          <ArrowDown
            class="size-4"
            aria-hidden="true"
          />
        </Button>
      </div>
      <SessionDemo />
    </div>
  </section>

  <section
    id="workflow"
    class="jg-section-space scroll-mt-16 border-b border-border"
    aria-labelledby="workflow-title"
  >
    <div class="jg-container">
      <p class="eyebrow">How it works</p>
      <h2
        id="workflow-title"
        class="section-title mt-4"
      >
        From a conversation to a pushed commit.
      </h2>
      <div class="mt-10">
        <WorkedExample />
      </div>
    </div>
  </section>

  <section
    id="skills"
    class="jg-section-space scroll-mt-16 border-b border-border"
    aria-labelledby="skills-title"
  >
    <div class="jg-container">
      <p class="eyebrow">The skills</p>
      <h2
        id="skills-title"
        class="section-title mt-4"
      >
        One skill for each step you control.
      </h2>
      <p class="lede mt-5">
        Explicit skills state exactly what they may change. Implicit skills add the stack-specific
        standards your agent needs on top of your repository's coding instructions.
      </p>
      <div class="mt-12 grid gap-12">
        {
          stages.map(({ label, skills: stageSkills, stage, summary }) => (
            <section aria-labelledby={`stage-${stage}`}>
              <div class="flex flex-col gap-1 border-b border-border pb-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                <h3
                  id={`stage-${stage}`}
                  class="text-xl font-semibold tracking-tight"
                >
                  {label}
                </h3>
                <p class="text-sm text-muted">{summary}</p>
              </div>
              <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {stageSkills.map((skill) => (
                  <li>
                    <SkillCard skill={skill} />
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="modes"
    class="jg-section-space border-b border-border"
    aria-labelledby="modes-title"
  >
    <div class="jg-container">
      <p class="eyebrow">Choose your pace</p><h2
        id="modes-title"
        class="section-title mt-4"
      >
        One unit at a time, or the remaining plan.
      </h2><div class="mt-10"><WorkflowRun /></div>
    </div>
  </section>

  <section
    id="install"
    class="jg-section-space scroll-mt-16 border-b border-border"
    aria-labelledby="install-title"
  >
    <div class="jg-container grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14">
      <div>
        <p class="eyebrow">Install</p>
        <h2
          id="install-title"
          class="section-title mt-4"
        >
          Add them to your project.
        </h2>
        <p class="lede mt-5">
          Install the planning runtime in each project. Add the skills from your repository's root,
          then commit them to share the workflow with your team.
        </p>
        <p class="mt-5 text-sm leading-6 text-muted">
          Planning workflows require Node.js 24.15 or newer and jg-plans {PLANNING_RUNTIME_VERSION},
          installed in your project. The skills use it to inspect and safely edit plans; they never
          install it automatically. No-plan tasks and code-only reviews need no runtime.
        </p>
        <p class="mt-3 text-sm leading-6 text-muted">
          Update refreshes only the skills you already have. To add skills released since you
          installed, run the install command again.
        </p>
      </div>
      <div class="grid gap-5">
        <InstallCommand
          command={SITE_CONFIG.commands.runtimeInstall}
          context="runtime install command"
          id="runtime-install-command"
          title="Project planning CLI"
        />
        <InstallCommand
          command={SITE_CONFIG.commands.install}
          context="install command"
          id="install-command"
          title="Install"
        />
        <InstallCommand
          command={SITE_CONFIG.commands.update}
          context="update command"
          id="update-command"
          title="Update"
        />
        <InstallCommand
          command={SITE_CONFIG.commands.remove}
          context="remove command"
          id="remove-command"
          title="Remove"
        />
      </div>
    </div>
  </section>

  <StandardsSection />

  <PackagesBridge />

  <Credits />
</BaseLayout>
