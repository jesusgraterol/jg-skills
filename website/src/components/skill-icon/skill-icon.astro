---
import {
  Bug,
  CirclePause,
  Database,
  FileTerminal,
  FlaskConical,
  FolderTree,
  Globe,
  Hammer,
  Image as ImageIcon,
  Lightbulb,
  ListOrdered,
  Map as MapIcon,
  MessagesSquare,
  MonitorSmartphone,
  Package,
  Puzzle,
  Scale,
  SearchCheck,
  ShieldQuestionMark,
  Ship,
  Terminal,
  Upload,
  VectorSquare,
  Workflow,
} from '@lucide/astro';
import IconTile from 'jg-personal-astro-ui/icon-tile';

import type {
  ISkillBrandMark,
  ISkillIcon,
  ISkillLucideIcon,
} from '../../utilities/skill-catalog/index.ts';

import { SKILL_BRAND_MARK_PATHS } from './constants.ts';

interface Props {
  icon: ISkillIcon;
  // `card` leads a skill card's top row; `header` opens a skill page
  size: 'card' | 'header';
}

// the Lucide component behind each Lucide icon key
const LUCIDE_ICONS = {
  bug: Bug,
  'circle-pause': CirclePause,
  database: Database,
  'file-terminal': FileTerminal,
  'flask-conical': FlaskConical,
  'folder-tree': FolderTree,
  globe: Globe,
  hammer: Hammer,
  image: ImageIcon,
  lightbulb: Lightbulb,
  'list-ordered': ListOrdered,
  map: MapIcon,
  'messages-square': MessagesSquare,
  'monitor-smartphone': MonitorSmartphone,
  package: Package,
  puzzle: Puzzle,
  scale: Scale,
  'search-check': SearchCheck,
  'shield-question-mark': ShieldQuestionMark,
  ship: Ship,
  terminal: Terminal,
  upload: Upload,
  'vector-square': VectorSquare,
  workflow: Workflow,
} as const satisfies Record<ISkillLucideIcon, typeof Bug>;

// the glyph's drawn size in each tile size, which the tile also sets with CSS
const GLYPH_PIXELS = { card: 20, header: 28 } as const;

/** Narrows an icon key to a technology mark. */
const isBrandMark = (icon: ISkillIcon): icon is ISkillBrandMark =>
  Object.hasOwn(SKILL_BRAND_MARK_PATHS, icon);

const { icon, size } = Astro.props;
const pixels = GLYPH_PIXELS[size];
// what draws the icon: a technology mark's path data, or a Lucide component
const glyph = isBrandMark(icon)
  ? ({ kind: 'brand', path: SKILL_BRAND_MARK_PATHS[icon] } as const)
  : ({ kind: 'lucide', Component: LUCIDE_ICONS[icon] } as const);
---

{/* decorative: the skill's name is always shown with the tile, which inverts in dark mode */}
<IconTile
  size={size}
  data-skill-icon={icon}
>
  {
    glyph.kind === 'lucide' ? (
      <glyph.Component size={pixels} />
    ) : (
      <svg
        viewBox="0 0 24 24"
        width={pixels}
        height={pixels}
        fill="currentColor"
        data-skill-brand-mark={icon}
      >
        <path d={glyph.path} />
      </svg>
    )
  }
</IconTile>
