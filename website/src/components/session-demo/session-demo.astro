---
import { UserRound } from '@lucide/astro';
import InlineCode from 'jg-personal-astro-ui/inline-code';

// who sends one message of the example conversation
type ISessionSpeaker = 'agent' | 'you';

/*
 * A static supervised example: the developer plans, builds and reviews with Claude Code. Commands and their slashes are rendered from expressions so
 * formatters cannot drop them.
 */
const CONVERSATION = [
  {
    command: 'jg-plan',
    speaker: 'you',
    text: 'Add an empty state to the search page.',
  },
  {
    command: undefined,
    speaker: 'agent',
    text: 'plan.md saved. Review the scope before building.',
  },
  { command: 'jg-execute', speaker: 'you', text: undefined },
  {
    command: undefined,
    speaker: 'agent',
    text: 'Implementation and checks complete. Ready for review.',
  },
  { command: 'jg-review', speaker: 'you', text: undefined },
  { command: undefined, speaker: 'agent', text: 'No blocking findings. Ready for jg-push.' },
] as const satisfies readonly {
  command: string | undefined;
  speaker: ISessionSpeaker;
  text: string | undefined;
}[];

// visible label for each speaker
const SPEAKER_LABELS = {
  agent: 'Claude Code',
  you: 'You',
} as const satisfies Record<ISessionSpeaker, string>;
---

<div
  data-session-demo
  class="rounded-2xl border border-border bg-surface p-5 shadow-surface sm:p-7"
>
  <p class="mb-6 font-mono text-xs text-muted">Illustrative session · supervised workflow</p>
  <ol
    class="grid min-w-0 gap-4"
    aria-label="Example conversation with Claude Code"
  >
    {
      CONVERSATION.map(({ command, speaker, text }) => (
        <li
          class:list={[
            'group relative flex min-w-0 items-start gap-3',
            speaker === 'you' && 'max-w-11/12 sm:max-w-none',
          ]}
          data-conversation-message={speaker}
        >
          {/* the rail joining each avatar to the next one */}
          <span
            class="absolute top-9 -bottom-4 left-4.5 w-px bg-border group-last:hidden"
            aria-hidden="true"
          />
          <span
            class:list={[
              'relative z-10 inline-flex size-9 shrink-0 items-center justify-center rounded-xl',
              speaker === 'you'
                ? 'bg-primary text-primary-foreground'
                : 'border border-border bg-secondary',
            ]}
            aria-hidden="true"
          >
            {speaker === 'you' ? (
              <UserRound class="size-4" />
            ) : (
              <img
                class="size-5"
                src="/coding-agents/claude-code.svg"
                width="20"
                height="20"
                alt=""
              />
            )}
          </span>
          <div
            class:list={[
              'min-w-0 rounded-2xl rounded-tl-sm border border-border px-4 py-3',
              speaker === 'you'
                ? 'bg-background shadow-surface'
                : 'flex-1 bg-surface shadow-raised',
            ]}
          >
            <span class="sr-only">{`${SPEAKER_LABELS[speaker]}: `}</span>
            <span
              class="block text-xs font-semibold text-muted"
              aria-hidden="true"
            >
              {SPEAKER_LABELS[speaker]}
            </span>
            <span class="mt-1 block text-sm leading-6 wrap-anywhere">
              {command && (
                <InlineCode
                  class="font-semibold"
                  code={`/${command}`}
                />
              )}
              {command && text && ' '}
              {text}
            </span>
          </div>
        </li>
      ))
    }
  </ol>
</div>
