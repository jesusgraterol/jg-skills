---
import Tabs from 'jg-personal-astro-ui/tabs';
import CodeBlock from 'jg-personal-astro-ui/code-block';
import TextLink from 'jg-personal-astro-ui/text-link';
import Card from 'jg-personal-astro-ui/card';
import { ArrowDown, ArrowRight, Check, FileText, ShieldCheck } from '@lucide/astro';
import { SITE_CONFIG } from '../../site.config.ts';

const steps = [
  {
    id: 'plan',
    label: 'Plan',
    skill: 'jg-plan',
    command: '/jg-plan Add an empty state for searches with no results.',
    title: 'Agree on a reviewable change.',
    outcome:
      'A plan records the goal, the scope and numbered acceptance criteria for you to approve.',
    artifact: 'plan.md',
    artifactType: 'markdown',
    source:
      '---\nid: example-empty-search\ncreated_at: 2026-10-22T12:00:00Z\nupdated_at: 2026-10-22T12:00:00Z\nrevision: 1\nstatus: pending\nprotocol: "0.2"\n---\n\n# Search empty state\n\nShow helpful feedback when a search returns no results.\n\n## Acceptance criteria\n\n- AC-01: A search with no results explains why.\n- AC-02: The empty state offers to clear the filters.\n- AC-03: Both work with a keyboard and a screen reader.\n',
    authority: 'It writes only planning documents; your next request authorizes building.',
  },
  {
    id: 'build',
    label: 'Build',
    skill: 'jg-execute',
    command: '/jg-execute',
    title: 'Build one approved unit.',
    outcome: 'The agent builds the empty state, runs its checks and stops for your review.',
    artifact: 'Implementation + check results',
    artifactType: 'text',
    source:
      'SearchResults.tsx\nSearchResults.test-e2e.ts\n\nExpected evidence\n• Empty results show useful feedback\n• Keyboard navigation remains usable\n• Returning results restore the normal view',
    authority: 'Supervised runs stop after one unit; publishing stays a separate step.',
  },
  {
    id: 'review',
    label: 'Review',
    skill: 'jg-review',
    command: '/jg-review',
    title: 'Review the actual task scope.',
    outcome: 'The review checks the change and its evidence against each acceptance criterion.',
    artifact: 'Review excerpt · expected successful result',
    artifactType: 'text',
    source:
      'Task scope\nSearchResults.tsx\nSearchResults.test-e2e.ts\n\nAC-01, AC-02, AC-03: met on evidence\nNo blocking findings.\nVerdict: Ready to commit',
    authority: 'It reads the actual changes and never commits or pushes them.',
  },
  {
    id: 'publish',
    label: 'Publish',
    skill: 'jg-push',
    command: '/jg-push',
    title: 'Publish the reviewed change.',
    outcome: 'The skill commits the task’s files with a signature and pushes the agreed branch.',
    artifact: 'Publication outcome · illustration',
    artifactType: 'text',
    source:
      'development\n  └─ signed task commit\n      └─ explicit push to the agreed remote branch',
    authority: 'Only the authorized task scope is staged and published.',
  },
] as const;
---

<section
  aria-label="Worked search empty-state example"
  class="min-w-0"
  data-worked-example
>
  <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
    <p class="flex items-center gap-2 text-sm font-semibold">
      <FileText
        class="size-4 text-accent"
        aria-hidden="true"
      /> Example task: a search empty state
    </p>
    <span class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted"
      >Illustrative workflow · supervised</span
    >
  </div>
  <Tabs
    class="[&_[role=tab]]:px-2 sm:[&_[role=tab]]:px-3"
    id="worked-example"
    label="Example workflow steps"
    tabs={steps}
  >
    {
      steps.map((step) => (
        <div
          slot={step.id}
          class="pt-7"
        >
          <div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12">
            <div class="min-w-0">
              <>
                <h3 class="text-2xl leading-tight font-semibold tracking-tight sm:text-3xl">
                  {step.title}
                </h3>
                <p class="mt-4 text-sm leading-7 text-muted">{step.outcome}</p>
                <div class="my-6 min-w-0">
                  <CodeBlock
                    code={step.command}
                    copyDisplay="icon"
                    overflow="wrap"
                    lang="text"
                    title="Claude Code invocation"
                  />
                </div>
                <p class="flex items-start gap-3 border-t border-border pt-5 text-sm leading-7 text-muted">
                  <ShieldCheck
                    class="mt-1 size-4 shrink-0 text-accent"
                    aria-hidden="true"
                  />
                  {step.authority}
                </p>
                <p class="mt-5 text-sm">
                  <TextLink href={`/skills/${step.skill}/`}>
                    Read {step.skill}{' '}
                    <ArrowRight
                      class="ml-1 inline size-3.5"
                      aria-hidden="true"
                    />
                  </TextLink>
                </p>
              </>
            </div>
            <div class="min-w-0">
              <>
                <p class="mb-3 font-mono text-xs text-muted">Illustrative artifact</p>
                <CodeBlock
                  code={step.source}
                  copyDisplay="icon"
                  overflow="wrap"
                  lang={step.artifactType}
                  title={step.artifact}
                />
              </>
            </div>
          </div>
        </div>
      ))
    }
  </Tabs>
  <div class="mt-8 grid gap-6 border-t border-border pt-6 md:grid-cols-2">
    <div>
      <p class="text-sm font-semibold">One small plan, one unit.</p><p
        class="mt-2 text-sm leading-7 text-muted"
      >
        Add <code class="font-mono text-foreground">jg-breakdown</code> when milestones help; in Codex,
        invoke skills with <code class="font-mono text-foreground">$</code> instead of <code
          class="font-mono text-foreground">/</code
        >.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold">Standards load on their own.</p>
      <div
        class="mt-3 flex min-w-0 flex-col items-start gap-2 text-sm sm:flex-row sm:flex-wrap sm:items-center"
      >
        <ul
          class="flex min-w-0 flex-wrap gap-2"
          aria-label="Files the task touches"
        >
          {
            ['SearchResults.tsx', 'SearchResults.test-e2e.ts'].map((file) => (
              <li class="rounded-md bg-code px-2 py-1 font-mono text-xs wrap-anywhere">{file}</li>
            ))
          }
        </ul>
        <ArrowDown
          class="size-4 shrink-0 text-muted sm:hidden"
          aria-hidden="true"
        />
        <ArrowRight
          class="hidden size-4 shrink-0 text-muted sm:block"
          aria-hidden="true"
        />
        <ul
          class="flex min-w-0 flex-wrap gap-2"
          aria-label="Standards that load for those files"
        >
          {
            [
              { name: 'jg-frontend', text: 'UI and accessibility' },
              { name: 'jg-react', text: 'React implementation' },
              { name: 'jg-testing', text: 'Browser checks' },
            ].map((skill) => (
              <li class="flex items-center gap-2 rounded-md bg-secondary px-3 py-2">
                <>
                  <Check
                    class="size-3 text-accent"
                    aria-hidden="true"
                  />
                  <TextLink href={`/skills/${skill.name}/`}>{skill.name}</TextLink>
                  <span class="sr-only">: {skill.text}</span>
                </>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <div class="mt-8 grid gap-4 border-t border-border pt-7 md:grid-cols-3">
    {
      [
        {
          name: 'jg-skills',
          role: 'The agent workflow',
          text: 'Explicit planning, execution, review and publication steps, with relevant coding standards.',
          href: '/skills/jg-plan/',
          external: false,
        },
        {
          name: 'jg-plans',
          role: 'The document tools',
          text: 'Acceptance criteria, progress and guarded edits for plan files.',
          href: SITE_CONFIG.plansUrl,
          external: true,
        },
        {
          name: 'jg-agent-hq',
          role: 'For your own application',
          text: 'Native sessions, review handoffs and checked plan approvals.',
          href: SITE_CONFIG.agentHqUrl,
          external: true,
        },
      ].map((project) => (
        <Card>
          <>
            <p class="font-mono text-xs text-accent">{project.role}</p>
            <h3 class="mt-3 font-semibold">
              <TextLink
                href={project.href}
                external={project.external}
              >
                {project.name}
              </TextLink>
            </h3>
            <p class="mt-3 text-sm leading-7 text-muted">{project.text}</p>
          </>
        </Card>
      ))
    }
  </div>
</section>
