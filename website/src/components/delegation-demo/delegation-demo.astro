---
import { Network, SquareTerminal } from '@lucide/astro';
import Conversation from 'jg-personal-astro-ui/conversation';
import ConversationMessage from 'jg-personal-astro-ui/conversation-message';
import InlineCode from 'jg-personal-astro-ui/inline-code';

// who sends one message of the example handoff
type IDelegationSpeaker = 'codex' | 'hq' | 'claude';

/*
 * A static review handoff through jg-agent-hq: Codex publishes a review request, HQ grants the
 * native jg-review-session skill to Claude Code for that request, and the report returns to Codex.
 */
const MESSAGES = [
  {
    speaker: 'codex',
    name: 'hq_message_publish',
    text: 'The CSV export is ready. Please review it.',
  },
  {
    speaker: 'hq',
    name: null,
    text: 'Grants jg-review-session for this request only.',
  },
  {
    speaker: 'claude',
    name: '/jg-review-session',
    text: 'Quoted fields work; an empty export loses its headers.',
  },
  {
    speaker: 'codex',
    name: 'hq_report_read',
    text: 'Fixed, with a regression test that passes.',
  },
] as const satisfies readonly {
  speaker: IDelegationSpeaker;
  name: string | null;
  text: string;
}[];

// visible label for each speaker
const SPEAKER_LABELS = {
  codex: 'Codex',
  hq: 'jg-agent-hq',
  claude: 'Claude Code',
} as const satisfies Record<IDelegationSpeaker, string>;
---

<div
  data-delegation-demo
  class="min-w-0 rounded-2xl border border-border bg-surface p-5 shadow-surface sm:p-7"
>
  <Conversation label="Example review handoff through jg-agent-hq">
    <p
      slot="header"
      class="font-mono text-xs text-muted"
    >
      Illustrative handoff · review by another agent
    </p>
    {
      MESSAGES.map(({ speaker, name, text }) => (
        <ConversationMessage speaker={SPEAKER_LABELS[speaker]}>
          <span
            slot="avatar"
            class:list={[
              'inline-flex size-8 items-center justify-center rounded-xl',
              speaker === 'hq'
                ? 'bg-primary text-primary-foreground'
                : 'border border-border bg-secondary',
            ]}
          >
            {speaker === 'claude' ? (
              <img
                class="size-5"
                src="/coding-agents/claude-code.svg"
                width="20"
                height="20"
                alt=""
              />
            ) : speaker === 'hq' ? (
              <Network class="size-4" />
            ) : (
              <SquareTerminal class="size-4" />
            )}
          </span>
          <p class="text-sm leading-6">
            {name && (
              <InlineCode
                class="font-semibold"
                code={name}
              />
            )}
            {name && ' '}
            {text}
          </p>
        </ConversationMessage>
      ))
    }
  </Conversation>
</div>
