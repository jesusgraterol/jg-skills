---
import Badge from 'jg-personal-astro-ui/badge';
import IconTile from 'jg-personal-astro-ui/icon-tile';
import LinkCard from 'jg-personal-astro-ui/link-card';

// one open-source collection whose ideas were adapted into these skills
interface ICredit {
  author: string;
  license: string;
  name: string;
  summary: string;
  url: string;
}

// collections whose ideas are rewritten in our own words, with summaries of similar length
const CREDITS = [
  {
    author: 'Jesse Vincent',
    license: 'MIT',
    name: 'superpowers',
    summary:
      'Fixing only blocking findings, checking acceptance criteria first, and a three-attempt stop rule.',
    url: 'https://github.com/obra/superpowers',
  },
  {
    author: 'Addy Osmani',
    license: 'MIT',
    name: 'agent-skills',
    summary:
      'Labeling review findings by severity, and listing what was noticed but deliberately left alone.',
    url: 'https://github.com/addyosmani/agent-skills',
  },
  {
    author: 'Lauren Tan',
    license: 'MIT',
    name: 'pstack',
    summary:
      'Proving a change works on the real path, and never weakening a check just to get it through.',
    url: 'https://github.com/poteto/plugins/tree/main/pstack',
  },
  {
    author: 'Matt Pocock',
    license: 'MIT',
    name: 'skills',
    summary:
      'Milestones that fit one context window, batched questions, and the debugging loop in jg-debug.',
    url: 'https://github.com/mattpocock/skills',
  },
] as const satisfies readonly ICredit[];

// GitHub's mark (mark-github-16 from Primer Octicons), used under the GitHub logo guidelines
// and shown unchanged beside each repository link
const GITHUB_MARK_PATH =
  'M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656';
---

<section
  id="credits"
  class="jg-section-space scroll-mt-16"
  aria-labelledby="credits-title"
>
  <div class="jg-container">
    <p class="eyebrow">Credits</p>
    <h2
      id="credits-title"
      class="section-title mt-4"
    >
      Ideas we built on.
    </h2>
    <p class="lede mt-5 max-w-2xl">
      A few ideas in these skills are adapted from other open-source collections and rewritten in
      our own words.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        CREDITS.map(({ author, license, name, summary, url }) => (
          <li>
            <LinkCard
              external
              href={url}
              monoTitle
              title={name}
              data-credit
            >
              <IconTile slot="icon">
                <svg
                  viewBox="0 0 16 16"
                  width="20"
                  height="20"
                  fill="currentColor"
                  data-github-mark
                >
                  <path d={GITHUB_MARK_PATH} />
                </svg>
              </IconTile>
              <p
                slot="meta"
                class="text-sm text-muted"
                data-credit-author
              >
                by {author}
              </p>
              <p class="text-pretty">{summary}</p>
              <Badge
                slot="footer"
                variant="neutral"
                data-credit-license
              >
                {license}
              </Badge>
            </LinkCard>
          </li>
        ))
      }
    </ul>
  </div>
</section>
