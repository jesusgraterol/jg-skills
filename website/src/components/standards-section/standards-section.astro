---
import { FilePlus, Link2, PencilRuler } from '@lucide/astro';
import JgMark from 'jg-personal-astro-ui/jg-mark';

import { SITE_CONFIG } from '../../site.config.ts';
import AgenticCodingMark from '../agentic-coding-mark/agentic-coding-mark.astro';
import ExternalLink from '../external-link/external-link.astro';

// one starting point on Agentic Coding, chosen by whether the repository already has an AGENTS.md
interface IStandardsCard {
  href: string;
  Icon: typeof FilePlus;
  label: string;
  text: string;
  title: string;
}

// both cases, in the order a visitor reads them
const STANDARDS_CARDS = [
  {
    href: SITE_CONFIG.agenticCodingStartUrl,
    Icon: FilePlus,
    label: 'No AGENTS.md yet',
    text: 'A neutral AGENTS.md for new or existing repositories, ready to copy or download.',
    title: 'Start from the foundation',
  },
  {
    href: SITE_CONFIG.agenticCodingRefineUrl,
    Icon: PencilRuler,
    label: 'Already have one',
    text: 'A prompt that improves your AGENTS.md without losing what it already knows about your project.',
    title: 'Refine what you have',
  },
] as const satisfies readonly IStandardsCard[];

/**
 * Splits a card's link into the host and path its destination line shows, so a narrow card can
 * break the line between them instead of inside a word.
 * @param href The card's absolute link.
 * @returns The host, and the path without its trailing slash.
 */
const toDestination = (href: string): { host: string; path: string } => {
  const { host, pathname } = new URL(href);

  return { host, path: pathname.replace(/\/$/u, '') };
};
---

<section
  id="standards"
  class="section-space scroll-mt-16 border-b border-border"
  aria-labelledby="standards-title"
>
  <div class="page-shell">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end lg:gap-14">
      <div>
        <p class="eyebrow">Agentic Coding</p>
        <h2
          id="standards-title"
          class="section-title mt-4"
        >
          Give your agent standards to follow.
        </h2>
        <p class="lede mt-5">
          The skills run the workflow. Your repository's{' '}
          <code class="font-mono text-[0.92em]">AGENTS.md</code>{' '}
          sets the standards each one applies, and Agentic Coding has a starting point either way.
        </p>
      </div>
      {/* the connector between the two items is decorative, so the list reads as two items */}
      <ol
        class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:items-center sm:gap-0"
        aria-label="How AGENTS.md and jg-skills fit together"
        data-standards-strip
      >
        {/* each item carries the mark of the project that provides it */}
        <li
          class="flex items-center gap-4 rounded-xl bg-primary p-5 text-primary-foreground shadow-raised"
        >
          <AgenticCodingMark class="size-10 shrink-0" />
          <div class="min-w-0">
            <code class="font-mono text-base font-bold">AGENTS.md</code>
            <span class="mt-1 block text-sm text-accent-on-primary">Sets the standards</span>
          </div>
        </li>
        <li
          class="flex flex-col items-center justify-center text-muted sm:flex-row"
          aria-hidden="true"
        >
          <span class="h-3 w-px bg-border-strong sm:h-px sm:w-4"></span>
          <span
            class="inline-flex size-8 items-center justify-center rounded-full border border-border bg-background"
          >
            <Link2
              class="size-4"
              size={16}
            />
          </span>
          <span class="h-3 w-px bg-border-strong sm:h-px sm:w-4"></span>
        </li>
        <li
          class="flex items-center gap-4 rounded-xl border border-border bg-surface p-5 shadow-surface"
        >
          <JgMark class="size-10 shrink-0" />
          <div class="min-w-0">
            <code class="font-mono text-base font-bold">jg-skills</code>
            <span class="mt-1 block text-sm text-muted">Runs the workflow</span>
          </div>
        </li>
      </ol>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        STANDARDS_CARDS.map(({ href, Icon, label, text, title }) => (
          <li>
            {/* the whole card is the link target, so the card draws the keyboard focus ring for it */}
            <article
              class="relative flex h-full flex-col rounded-xl border border-border bg-surface p-5 shadow-surface transition-colors hover:border-border-strong has-focus-visible:outline-2 has-focus-visible:outline-offset-3 has-focus-visible:outline-focus motion-reduce:transition-none"
              data-standards-card
            >
              {/* the case badge shares the top row with the corner arrow, raised to center on it */}
              <p
                class="-mt-[3px] w-fit rounded-full border border-border px-2.5 py-0.5 font-mono text-xs font-semibold text-muted"
                data-standards-case
              >
                {label}
              </p>
              <div class="mt-4 flex items-center gap-4">
                <span
                  class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground"
                  aria-hidden="true"
                >
                  <Icon
                    class="size-5"
                    size={20}
                  />
                </span>
                <h3 class="min-w-0 text-lg font-semibold tracking-tight">
                  <ExternalLink
                    class="no-underline outline-none after:absolute after:inset-0 after:rounded-xl"
                    cornerArrow
                    href={href}
                  >
                    {title}
                  </ExternalLink>
                </h3>
              </div>
              <p class="mt-4 flex-1 text-sm leading-6 text-pretty text-muted">{text}</p>
              <p
                class="mt-5 font-mono text-xs wrap-anywhere text-muted"
                data-standards-destination
              >
                {toDestination(href).host}
                <wbr />
                {toDestination(href).path}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
