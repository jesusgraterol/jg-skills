---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import Breadcrumb from 'jg-personal-astro-ui/breadcrumb';
import Button from 'jg-personal-astro-ui/button';
import Prose from 'jg-personal-astro-ui/prose';
import TerminalWindow from 'jg-personal-astro-ui/terminal-window';

import {
  SKILL_ACCESS_LABELS,
  SKILL_STAGES,
  type ISkill,
} from '../../utilities/skill-catalog/index.ts';
import { SITE_CONFIG } from '../../site.config.ts';
import SkillIcon from '../skill-icon/skill-icon.astro';

interface Props {
  // neighboring skills in catalog order, absent at either end
  next?: ISkill | undefined;
  previous?: ISkill | undefined;
  skill: ISkill;
}

const { next, previous, skill } = Astro.props;
// The catalog checks every entry has safe rendered HTML before it reaches this component.
const instructionsHtml = skill.entry.rendered?.html ?? '';
const isImplicit = skill.kind === 'implicit';
const hasCases = !isImplicit && skill.examples.length > 1;
// implicit skills open with their summary, because their description is a trigger list for agents
const lede = skill.kind === 'implicit' ? skill.summary : skill.description;
// explicit examples highlight the invoked skill name; implicit examples are plain requests
const examples =
  skill.kind === 'explicit'
    ? skill.examples.map((example, index) => {
        // the skill name, highlighted, and any text supplied with it
        const [name = skill.name, ...words] = example.invocation.split(' ');
        const label = 'label' in example ? example.label : undefined;

        return {
          copyContext: label ? `${label.toLowerCase()} invocation` : 'invocation',
          id: `${skill.name}-invocation-${index + 1}`,
          name,
          outcome: example.outcome,
          text: words.length > 0 ? ` ${words.join(' ')}` : '',
          title: label ?? 'Example',
        };
      })
    : skill.examples.map((example, index) => ({
        copyContext: 'request',
        id: `${skill.name}-request-${index + 1}`,
        name: undefined,
        outcome: example.outcome,
        text: example.request,
        title: 'Example',
      }));
---

<article class="jg-container-prose py-12 sm:py-16">
  <Breadcrumb
    items={[
      { href: '/', name: SITE_CONFIG.name },
      { href: `/skills/${skill.name}/`, name: skill.name },
    ]}
  />

  <header class="mt-10">
    <SkillIcon
      icon={skill.icon}
      size="header"
    />
    <p class="eyebrow mt-6">{SKILL_STAGES[skill.stage].label}</p>
    <h1 class="mt-4 font-mono text-4xl font-bold tracking-tight wrap-anywhere sm:text-5xl">
      {skill.name}
    </h1>
    <p
      class="lede mt-5"
      data-skill-lede
    >
      {lede}
    </p>
    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      {
        skill.kind === 'explicit' && (
          <div>
            <dt class="font-mono text-xs font-bold text-muted uppercase">May change</dt>
            <dd class="mt-1 font-semibold">{SKILL_ACCESS_LABELS[skill.access]}</dd>
          </div>
        )
      }
      <div>
        <dt class="font-mono text-xs font-bold text-muted uppercase">Usage</dt>
        {
          isImplicit ? (
            <dd
              class="mt-1 font-semibold"
              data-skill-usage
            >
              Loads automatically
            </dd>
          ) : (
            <dd class="mt-1">
              <code
                class="font-mono font-semibold"
                data-skill-usage
              >{`/${skill.name}${skill.argumentHint ? ` ${skill.argumentHint}` : ''}`}</code>
            </dd>
          )
        }
      </div>
    </dl>
  </header>

  <section
    class="mt-12"
    aria-labelledby="when-to-use-heading"
  >
    <h2
      id="when-to-use-heading"
      class="text-2xl font-semibold tracking-tight"
    >
      When to use it
    </h2>
    <p
      class="mt-3 leading-7"
      data-skill-when-to-use
    >
      {skill.whenToUse}
    </p>
  </section>

  <section
    class="mt-12"
    aria-labelledby="example-heading"
  >
    <h2
      id="example-heading"
      class="text-2xl font-semibold tracking-tight"
    >
      {isImplicit ? 'When it loads' : hasCases ? 'Examples' : 'Example'}
    </h2>
    <p class="mt-2 text-sm leading-6 text-muted">
      {
        isImplicit
          ? 'Your agent loads the skill on its own when a request like this touches its area.'
          : 'Invoke the skill by name in your coding agent, followed by any text it should consider.'
      }
      {hasCases && ' Each example shows one supported case.'}
    </p>
    <div class="mt-5 grid gap-4">
      {
        examples.map((example) => (
          <TerminalWindow
            copy={{ context: example.copyContext, sourceId: example.id }}
            title={example.title}
          >
            <p class="flex gap-3">
              <span
                class="flex h-6 w-3 shrink-0 justify-center text-terminal-foreground/50 select-none"
                aria-hidden="true"
              >
                {'>'}
              </span>
              {example.name === undefined ? (
                <code
                  class="min-w-0 wrap-anywhere"
                  id={example.id}
                  data-skill-request
                >
                  {example.text}
                </code>
              ) : (
                <code
                  class="min-w-0 wrap-anywhere"
                  id={example.id}
                  data-skill-invocation
                >
                  <span class="font-bold text-terminal-accent">{`/${example.name}`}</span>
                  {example.text}
                </code>
              )}
            </p>
            <p class="mt-3 flex gap-3 text-terminal-foreground/70">
              <span
                class="flex h-6 w-3 shrink-0 items-center justify-center"
                aria-hidden="true"
              >
                <span class="size-1.5 rounded-full bg-terminal-accent" />
              </span>
              <span data-skill-outcome>{example.outcome}</span>
            </p>
          </TerminalWindow>
        ))
      }
    </div>
  </section>

  <section
    class="mt-14 border-t border-border pt-10"
    aria-labelledby="instructions-label"
  >
    <p class="eyebrow">SKILL.md</p>
    {
      /* a label, not a heading, so the SKILL.md sections keep their own h2 level beneath the page h1 */
    }
    <p
      id="instructions-label"
      class="mt-3 text-2xl font-semibold tracking-tight"
    >
      What the agent reads
    </p>
    <p class="mt-2 text-sm leading-6 text-muted">
      {
        isImplicit
          ? 'The complete instructions your agent loads when a task touches its area.'
          : `The complete instructions your agent loads when you invoke ${skill.name}.`
      }
    </p>
    {
      /* the Markdown, which the catalog and verify-build check, sits alone in its data-skill-markdown wrapper */
    }
    <Prose
      class="mt-6 rounded-xl border border-border bg-surface px-5 py-6 shadow-surface sm:px-8 sm:py-8"
      data-skill-instructions
      data-skill-markdown
    >
      <Fragment set:html={instructionsHtml} />
    </Prose>
    {
      skill.references.length > 0 && (
        <div
          class="mt-10"
          data-skill-references
        >
          <p class="text-xl font-semibold tracking-tight">Reference files</p>
          <p class="mt-2 text-sm leading-6 text-muted">
            The agent reads each file only when its task needs it, as SKILL.md says.
          </p>
          {skill.references.map(({ entry, path }) => (
            <div
              class="mt-6"
              data-skill-reference={path}
            >
              <p class="font-mono text-sm font-semibold wrap-anywhere text-foreground">{path}</p>
              <Prose
                class="mt-3 rounded-xl border border-border bg-surface px-5 py-6 shadow-surface sm:px-8 sm:py-8"
                data-skill-markdown
              >
                <Fragment set:html={entry.rendered?.html ?? ''} />
              </Prose>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <footer class="mt-14 border-t border-border pt-8">
    <nav
      class="grid gap-3 sm:grid-cols-2"
      aria-label="Previous and next skills"
    >
      {
        previous && (
          <a
            class="flex flex-col gap-1 rounded-xl border border-border bg-surface p-4 no-underline transition-colors hover:border-border-strong"
            href={`/skills/${previous.name}/`}
            rel="prev"
          >
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted">
              <ArrowLeft
                class="size-3.5"
                aria-hidden="true"
              />
              Previous skill
            </span>
            <span class="font-mono font-bold wrap-anywhere">{previous.name}</span>
          </a>
        )
      }
      {
        next && (
          <a
            class="flex flex-col items-end gap-1 rounded-xl border border-border bg-surface p-4 text-right no-underline transition-colors hover:border-border-strong sm:col-start-2"
            href={`/skills/${next.name}/`}
            rel="next"
          >
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted">
              Next skill
              <ArrowRight
                class="size-3.5"
                aria-hidden="true"
              />
            </span>
            <span class="font-mono font-bold wrap-anywhere">{next.name}</span>
          </a>
        )
      }
    </nav>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button
        href="/#skills"
        variant="outline"
      >
        <ArrowLeft
          class="size-4"
          aria-hidden="true"
        />
        All skills
      </Button>
      <Button
        external
        href={skill.sourceUrl}
        variant="outline"
      >
        View SKILL.md on GitHub
      </Button>
    </div>
  </footer>
</article>
