---
import { SITE_CONFIG } from '../../site.config.ts';
import ExternalLink from '../external-link/external-link.astro';

import { splitMarkdownLinks } from './markdown-links.ts';

interface Props {
  html: string;
}

const parts = splitMarkdownLinks(Astro.props.html, SITE_CONFIG.url);
---

{
  parts.map((part) =>
    part.kind === 'external-link' ? (
      <ExternalLink
        {...part.attributes}
        href={part.href}
      >
        <Fragment set:html={part.html} />
      </ExternalLink>
    ) : (
      <Fragment set:html={part.html} />
    ),
  )
}
