---
import { ArrowUpRight, ExternalLink as ExternalLinkIcon } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';

import { SITE_CONFIG } from '../../site.config.ts';

interface Props extends HTMLAttributes<'a'> {
  // pins an up-right arrow to the top-right corner of the nearest positioned card instead of
  // showing the inline new-tab icon; for links that cover a whole card
  cornerArrow?: boolean | undefined;
  href: string;
}

// spoken after the link text so screen reader users know the link opens a new tab
const NEW_TAB_NOTICE = ' (opens in a new tab)';

const { class: className, cornerArrow = false, href, ...attributes } = Astro.props;
// links to the author's own sites keep their referrer; third-party sites get none
const { hostname } = new URL(href);
const isOwnedSite =
  hostname === SITE_CONFIG.ownedDomain || hostname.endsWith(`.${SITE_CONFIG.ownedDomain}`);
---

<a
  {...attributes}
  class={className}
  href={href}
  target="_blank"
  rel={isOwnedSite ? undefined : 'noreferrer'}
  aria-label={attributes['aria-label'] ? `${attributes['aria-label']}${NEW_TAB_NOTICE}` : undefined}
  ><slot />{
    cornerArrow ? (
      <ArrowUpRight
        class="absolute top-5 right-5 size-4 text-muted"
        aria-hidden="true"
        data-external-icon
      />
    ) : (
      <ExternalLinkIcon
        class="ml-1 inline-block size-3.5 shrink-0 align-[-0.125em]"
        aria-hidden="true"
        data-external-icon
      />
    )
  }<span class="sr-only">{NEW_TAB_NOTICE}</span></a
>
